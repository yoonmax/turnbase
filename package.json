    "cubing": "^0.66.1",
    "gsap": "^3.15.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
